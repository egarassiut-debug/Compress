<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:background="#0F172A">

    <!-- شريط العنوان -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F766E"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <Button
            android:id="@+id/btn_scanner_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="رجوع"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_icon_box"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_scanner_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="تصوير المستندات أوفلاين"
            android:textColor="#FFFFFF"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_scanner_mode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="تلقائي"
            android:textColor="#09183B"
            android:background="@drawable/bg_share_button"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- حاوية المعاينة المباشرة للكاميرا أو المراجعة -->
    <FrameLayout
        android:id="@+id/scanner_stage_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <SurfaceView
            android:id="@+id/camera_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/iv_review_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_stability_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_toast_navy"
            android:textColor="#FDE047"
            android:textSize="11.5sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- أزرار التحكم السفلية -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#09183B"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/layout_camera_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_flash_toggle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="فلاش: إيقاف"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_icon_box"
                android:textSize="11.5sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_capture_page"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="التقاط ورقة"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_card_teal"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_open_review"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="مراجعة (0)"
                android:textColor="#0F2557"
                android:background="@drawable/bg_share_button"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_review_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- شريط التنقل والترتيب والمعاينة -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btn_prev_page"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="السابق"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="10.5sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_next_page"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="التالي"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="10.5sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_move_prev"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="تقديم"
                    android:textColor="#FDE047"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="10.5sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_move_next"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="تأخير"
                    android:textColor="#FDE047"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="10.5sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_full_preview"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="معاينة"
                    android:textColor="#5EEAD4"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_rotate_45"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="تدوير 45°"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="10.5sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_crop_margin"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="ضبط القص"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="10.5sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_retake_page"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="إعادة تصوير"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="10.5sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_delete_page"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="حذف"
                    android:textColor="#FCA5A5"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="10.5sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_add_more_pages"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="إضافة"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_save_dual_outputs"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="حفظ Scan_001.. بالمعرض و PDF بالتنزيلات (&lt; 500 KB)"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_card_teal"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
