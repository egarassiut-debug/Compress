<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:background="#0F172A">

    <!-- شريط العنوان العلوي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F766E"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <Button
            android:id="@+id/btn_scanner_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="الرئيسية"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_icon_box"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tv_scanner_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="تصوير وتجميع المستندات"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_scanner_mode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="تلقائي"
            android:textColor="#09183B"
            android:background="@drawable/bg_share_button"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- مؤشر المراحل الثلاث -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#09183B"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/btn_step_capture"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="1. التصوير"
            android:textColor="#09183B"
            android:background="@drawable/bg_share_button"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_step_review"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="2. المراجعة"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_icon_box"
            android:textSize="11sp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_step_export"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="3. الحفظ"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_icon_box"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- حاوية العرض الرئيسية -->
    <FrameLayout
        android:id="@+id/scanner_stage_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <SurfaceView
            android:id="@+id/camera_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.legal_file_compressor.ScannerOverlayView
            android:id="@+id/scanner_overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/iv_review_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@null" />

        <com.example.legal_file_compressor.CropOverlayView
            android:id="@+id/crop_overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_stability_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_toast_navy"
            android:text="وجّه الكاميرا نحو الورقة لاكتشاف حدودها تلقائياً"
            android:textColor="#FDE047"
            android:textSize="11.5sp"
            android:visibility="visible" />

        <!-- المرحلة 3: شاشة الحفظ والتصدير المستقلة -->
        <ScrollView
            android:id="@+id/scroll_export_stage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F8FAFC"
            android:visibility="gone"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- ملخص الصفحات الجاهزة -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#E2E8F0"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_export_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="الصفحات الجاهزة للحفظ: 0 صفحة"
                        android:textColor="#09183B"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_export_subsummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="الهدف: أقل من 500 كيلوبايت مع الحفاظ التام على وضوح النصوص والأختام"
                        android:textColor="#475569"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- خيارات التصدير -->
                <LinearLayout
                    android:id="@+id/layout_export_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btn_save_images_only"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="1. حفظ الصور بالمعرض (أقل من 500 KB)"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_card_blue"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <Button
                        android:id="@+id/btn_save_pdf_only"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="2. حفظ PDF موحد بالتنزيلات (أقل من 500 KB)"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_card_teal"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />
                </LinearLayout>

                <!-- لوحة التأكيد بعد الحفظ الناجح -->
                <LinearLayout
                    android:id="@+id/layout_post_save_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#ECFDF5"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_post_save_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✓ تم الحفظ بنجاح"
                        android:textColor="#065F46"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_post_save_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="تم حفظ المستند بنجاح."
                        android:textColor="#047857"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btn_open_saved_file"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="فتح الملف المحفوظ"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_card_teal"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btn_export_other_format"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="تصدير بالصيغة الأخرى أيضاً"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_card_blue"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btn_start_new_scan"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="بدء عملية تصوير جديدة"
                        android:textColor="#09183B"
                        android:background="@drawable/bg_share_button"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- أزرار التحكم السفلية -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#09183B"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- المرحلة 1: أزرار التصوير وتجميع المستندات -->
        <LinearLayout
            android:id="@+id/layout_camera_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_flash_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="فلاش"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="11sp"
                    android:layout_marginEnd="5dp" />

                <Button
                    android:id="@+id/btn_studio_import"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="من الاستوديو"
                    android:textColor="#5EEAD4"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="5dp" />

                <Button
                    android:id="@+id/btn_capture_page"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="التقاط"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_card_teal"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_open_review"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="التالي (0)"
                    android:textColor="#09183B"
                    android:background="@drawable/bg_share_button"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:layout_marginStart="5dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- محرر القص اليدوي للزوايا الأربع -->
        <LinearLayout
            android:id="@+id/layout_crop_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btn_crop_auto_detect"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="كشف تلقائي للزوايا"
                    android:textColor="#5EEAD4"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_crop_reset_full"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="كامل الصورة"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_crop_cancel"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="إلغاء"
                    android:textColor="#FCA5A5"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_crop_apply"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="2"
                    android:text="تطبيق القص والمنظور"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_card_teal"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- المرحلة 2: مراجعة الصفحات وتحسينها (أدوات أساسية + قائمة تحرير مطوية) -->
        <LinearLayout
            android:id="@+id/layout_review_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- شريط التنقل والإضافة والمعاينة -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="5dp">

                <Button
                    android:id="@+id/btn_prev_page"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="السابقة"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="10.5sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_next_page"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="التالية"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="10.5sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_full_preview"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="تكبير"
                    android:textColor="#5EEAD4"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="10.5sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_add_more_pages"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="+ كاميرا"
                    android:textColor="#5EEAD4"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="10.5sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_review_import_studio"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="+ استوديو"
                    android:textColor="#FDE047"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- شريط الأدوات الأساسية في صف واحد -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="5dp">

                <Button
                    android:id="@+id/btn_rotate_right_90"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="يمين 90°"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="9.5sp"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btn_rotate_left_90"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="يسار 90°"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="9.5sp"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btn_move_prev"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="0.8"
                    android:text="تقديم"
                    android:textColor="#FDE047"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="9.5sp"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btn_move_next"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="0.8"
                    android:text="تأخير"
                    android:textColor="#FDE047"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="9.5sp"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btn_retake_page"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="0.8"
                    android:text="إعادة"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="9.5sp"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btn_delete_page"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="0.8"
                    android:text="حذف"
                    android:textColor="#FCA5A5"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="9.5sp"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btn_toggle_edit_tools"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.3"
                    android:text="أدوات التحرير"
                    android:textColor="#5EEAD4"
                    android:background="@drawable/bg_icon_box"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- قائمة أدوات التحرير الثانوية (مخفية افتراضياً) -->
            <LinearLayout
                android:id="@+id/layout_edit_tools_drawer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0F172A"
                android:padding="6dp"
                android:layout_marginBottom="6dp"
                android:visibility="gone">

                <!-- القص + الإضاءة + ضبط تلقائي -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="5dp">

                    <Button
                        android:id="@+id/btn_manual_crop"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1.3"
                        android:text="القص والمنظور"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_card_blue"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_brightness_down"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="0.8"
                        android:text="إضاءة -"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_icon_box"
                        android:textSize="10sp"
                        android:layout_marginEnd="3dp" />

                    <TextView
                        android:id="@+id/tv_brightness_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:gravity="center"
                        android:text="تلقائي"
                        android:textColor="#5EEAD4"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btn_brightness_up"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="0.8"
                        android:text="إضاءة +"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_icon_box"
                        android:textSize="10sp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_auto_adjust"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1.1"
                        android:text="تحسين تلقائي"
                        android:textColor="#09183B"
                        android:background="@drawable/bg_share_button"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- أوضاع الألوان -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_filter_color"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="ألوان أصلية ✓"
                        android:textColor="#09183B"
                        android:background="@drawable/bg_share_button"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_filter_gray"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="تدرج رمادي"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_icon_box"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_filter_bw"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="أبيض وأسود"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_icon_box"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- زر الانتقال الرئيسي للمرحلة 3 -->
            <Button
                android:id="@+id/btn_go_to_export"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="التالي: الحفظ والتصدير"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_card_teal"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- المرحلة 3: أزرار التنقل السفلية -->
        <LinearLayout
            android:id="@+id/layout_export_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_back_to_review"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="السابق: المراجعة"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_icon_box"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_export_add_more"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="+ إضافة صفحات"
                android:textColor="#09183B"
                android:background="@drawable/bg_share_button"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
