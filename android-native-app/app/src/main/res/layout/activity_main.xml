<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="#F8FAFC">

    <!-- الشريط العلوي الرسمي: اسم ضغطة باللون الكحلي الملكي والذهبي + زر المشاركة -->
    <LinearLayout
        android:id="@+id/layout_top_bar_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0F2557"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline"
                    android:textColor="#FDE047"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- زر مشاركة التطبيق العلوي -->
            <Button
                android:id="@+id/btn_share_app_header"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="78dp"
                android:text="مشاركة ↗"
                android:textColor="#0F2557"
                android:background="@drawable/bg_share_button"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />
        </LinearLayout>

        <!-- خط ذهبي رفيع يعزز الهوية البصرية -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:background="#D4AF37" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_top_bar_wrapper"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp">

            <!-- بطاقة الترحيب بالشعار المرفق وجملة الترحيب مع الميزان والوصف المختصر -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_welcome_card"
                android:elevation="2dp"
                android:padding="10dp"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/iv_welcome_logo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/welcome_logo"
                    android:background="@drawable/bg_mascot_frame"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/app_name"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/welcome_title"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_scale_gold"
                            android:layout_marginStart="6dp"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/welcome_subtitle"
                        android:textColor="#CBD5E1"
                        android:textSize="10.5sp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:lineSpacingExtra="1dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- عنوان قسم الخدمات الأربع -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_tools"
                android:textColor="#0F2557"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <!-- 1. الخدمة الأولى (الأزرق): تصغير حجم الصور -->
            <LinearLayout
                android:id="@+id/btn_compress_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_blue"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_num_circle"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#1D4ED8"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="9dp" />

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_box"
                    android:layout_marginEnd="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_service_image"
                        android:contentDescription="@string/service_1_title" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/service_1_title"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/service_1_desc"
                        android:textColor="#DBEAFE"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_left"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- 2. الخدمة الثانية (البرتقالي): تصغير حجم ملفات PDF -->
            <LinearLayout
                android:id="@+id/btn_compress_pdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_orange"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_num_circle"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#C2410C"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="9dp" />

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_box"
                    android:layout_marginEnd="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_service_pdf"
                        android:contentDescription="@string/service_2_title" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/service_2_title"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/service_2_desc"
                        android:textColor="#FFEDD5"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_left"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- 3. الخدمة الثالثة (الأخضر): دمج الصور في ملف PDF واحد -->
            <LinearLayout
                android:id="@+id/btn_merge_pdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_green"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_num_circle"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="#047857"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="9dp" />

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_box"
                    android:layout_marginEnd="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_service_merge"
                        android:contentDescription="@string/service_3_title" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/service_3_title"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/service_3_desc"
                        android:textColor="#D1FAE5"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_left"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- 4. الخدمة الرابعة (التركواز): تصوير المستندات وتحسينها وضغطها -->
            <LinearLayout
                android:id="@+id/btn_document_scanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_teal"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_num_circle"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="#0F766E"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="9dp" />

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_box"
                    android:layout_marginEnd="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_service_scanner"
                        android:contentDescription="@string/service_4_title" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/service_4_title"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/service_4_desc"
                        android:textColor="#CCFBF1"
                        android:textSize="10sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_left"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- 5. الخدمة الخامسة (البنفسجي): البوابات القانونية -->
            <LinearLayout
                android:id="@+id/card_portals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_purple"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_num_circle"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="#6D28D9"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="9dp" />

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_box"
                    android:layout_marginEnd="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_service_portals"
                        android:contentDescription="@string/service_5_title" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/service_5_title"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/service_5_desc"
                        android:textColor="#EDE9FE"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_left"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- نص الحالة البسيط والموجز -->
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:background="@drawable/bg_status_pill"
                android:textColor="#1E293B"
                android:textSize="11.5sp"
                android:text="جاهز لاختيار وضغط الملفات تلقائياً..."
                android:layout_marginBottom="6dp" />

            <!-- شريط معلومات الحفظ في المعرض والتنزيلات -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/saved_in_downloads"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:gravity="center" />

            <!-- التذييل الرسمي الهادئ (نفس التصميم السابق صغير وببروز منخفض) -->
            <LinearLayout
                android:id="@+id/layout_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tv_designer_credit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/designer_credit"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tv_brand_credit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/brand_credit"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- مربع حوار تأكيد الحفظ في منتصف الشاشة (بدلاً من شريط الإشعار السفلي) -->
    <FrameLayout
        android:id="@+id/layout_save_dialog_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8009183B"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layout_save_dialog_card"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_save_dialog"
            android:clickable="true"
            android:focusable="true"
            android:elevation="12dp"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- شريط علوي يحتوي زر الإغلاق × -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/btn_dialog_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentStart="true"
                    android:gravity="center"
                    android:text="×"
                    android:textColor="#64748B"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_check_circle_emerald"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_dialog_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="#0F2557"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:text="تم الحفظ في الاستوديو بنجاح" />

            <TextView
                android:id="@+id/tv_dialog_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="#64748B"
                android:textSize="11.5sp"
                android:text="(الحجم: 145 KB)" />

            <Button
                android:id="@+id/btn_dialog_open"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_dialog_open_btn"
                android:text="فتح الملف"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
